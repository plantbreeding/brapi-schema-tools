{
  "openapi": "3.0.3",
  "info": {
    "title": "Nullable Ref Fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/locations": {
      "get": {
        "operationId": "getLocations",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "coordinates": {
                      "description": "Search area",
                      "nullable": true,
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/geoJSONSearchArea"
                        }
                      ]
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "geoJSONSearchArea": {
        "type": "object",
        "properties": {
          "geometry": {
            "type": "object"
          }
        }
      }
    }
  }
}